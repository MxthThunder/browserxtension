# ==============================================================================
# PriviBrowse-X / Privacy-Preserving Browser Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env in this directory (server/.env) or project root:
#   cp .env.example .env
#
# NOTE: The server works 100% offline out-of-the-box using the built-in
# Universal Semantic NLP Reasoner and local Ollama. Cloud VLMs are OPTIONAL.
# ==============================================================================

# ── Cloud VLM Providers (Optional) ────────────────────────────────────────────
# If either is provided, the server can use cloud reasoning for complex web tasks
# with zero data leakage (only sanitized, redacted frames & tokens are sent).

# Google Gemini API Key (e.g. from https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (e.g. from https://platform.openai.com/)
OPENAI_API_KEY=

# ── Local Ollama Model (Optional) ─────────────────────────────────────────────
# Used when running local Qwen (e.g., `ollama run qwen2.5:0.5b`)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=8001
HOST=127.0.0.1
